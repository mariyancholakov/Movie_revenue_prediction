# Frontend environment contract. Copy to `.env.local` for local dev.
# On the host (e.g. Vercel), set NEXT_PUBLIC_API_URL to the deployed API origin.

# Base URL of the Flask API. Inlined at build time: `next build` fails if it is
# unset; `next dev` falls back to http://127.0.0.1:5000.
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000

# Optional, server-only (never NEXT_PUBLIC_): the same secret as the API's
# INTERNAL_API_KEY, so the server's page fetches get their own rate limit.
# INTERNAL_API_KEY=

# Optional: Google Search Console's HTML-tag verification value (the
# content="…" of the tag it gives you), rendered as a <meta> on every page.
# GOOGLE_SITE_VERIFICATION=

# Optional: the public origin for the sitemap and link previews. On Vercel it
# defaults to the production URL; set it only for a custom domain.
# SITE_URL=https://moviegross.vercel.app
