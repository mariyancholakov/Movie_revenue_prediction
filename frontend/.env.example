# Frontend environment contract. Copy to `.env.local` for local dev.
# On the host (e.g. Vercel), set NEXT_PUBLIC_API_URL to the deployed API origin.

# Base URL of the Flask API. Inlined at build time: `next build` fails if it is
# unset; `next dev` falls back to http://127.0.0.1:5000.
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000
