# ── Python ──────────────────────────────────────────────────────────────────
flask-api/venv/
**/__pycache__/
**/*.pyc
**/*.pyo
flask-api/.env
flask-api/.env.*
!flask-api/.env.example

# retrain.py artifacts — timestamped candidates and model backups
flask-api/models/candidate_*.pkl
flask-api/models/candidate_*_ranges.json
flask-api/models/box_office_model_backup_*.pkl
# scheduled-pipeline runtime state + logs
flask-api/models/pipeline_state.json
flask-api/logs/

# ── Next.js ──────────────────────────────────────────────────────────────────
frontend/.next/
frontend/out/
frontend/build/
frontend/node_modules/
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# ── General ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pem
*.key
*.p12
*.pfx

# Impeccable local/verification artifacts
.impeccable/review/
.impeccable/config.local.json
