<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly MovieGross pipeline: capture finished theatrical runs and retrain once
  enough new labelled data has accumulated (see capture_finished.py).

  Install:
    cp flask-api/scripts/com.moviegross.weekly-capture.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.moviegross.weekly-capture.plist
  Run once now to test:
    launchctl start com.moviegross.weekly-capture
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.moviegross.weekly-capture.plist
    rm ~/Library/LaunchAgents/com.moviegross.weekly-capture.plist

  To let an auto-retrain deploy a winning model unattended, add
  CAPTURE_AUTO_PROMOTE=1 to EnvironmentVariables below (off by default).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.moviegross.weekly-capture</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/mariyancholakov/Developer/projects/Box_Office_Prediction/Movie_revenue_prediction/flask-api/venv/bin/python</string>
        <string>/Users/mariyancholakov/Developer/projects/Box_Office_Prediction/Movie_revenue_prediction/flask-api/capture_finished.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mariyancholakov/Developer/projects/Box_Office_Prediction/Movie_revenue_prediction/flask-api</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CAPTURE_RETRAIN_THRESHOLD</key>
        <string>10</string>
    </dict>

    <!-- Weekly: Sundays at 03:00. If the Mac is asleep, launchd runs it on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/mariyancholakov/Developer/projects/Box_Office_Prediction/Movie_revenue_prediction/flask-api/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mariyancholakov/Developer/projects/Box_Office_Prediction/Movie_revenue_prediction/flask-api/logs/launchd.log</string>
</dict>
</plist>
