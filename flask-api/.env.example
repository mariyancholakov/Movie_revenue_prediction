# MOVIEGROSS API — environment contract. Copy to `.env` and fill in real values.
# Never commit the real .env (it is gitignored).

# --- Required secrets ---
TMDB_API_KEY=your_tmdb_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_or_anon_key

# --- Deployment config ---
# Comma-separated browser origins allowed to call the API (the deployed frontend URL).
# Defaults to http://localhost:3000 when unset.
ALLOWED_ORIGINS=http://localhost:3000

# Port to bind. Most hosts (Render/Railway) inject PORT automatically.
PORT=5000

# Set to 1/true ONLY for local debugging. Must stay off in production.
FLASK_DEBUG=0
