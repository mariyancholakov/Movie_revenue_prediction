# MOVIEGROSS API — environment contract. Copy to `.env` and fill in real values.
# Never commit the real .env (it is gitignored).

# --- Required secrets ---
TMDB_API_KEY=your_tmdb_api_key
SUPABASE_URL=https://your-project.supabase.co
# Must be the SECRET key (sb_secret_…, Project Settings → API Keys), not the
# publishable one. It bypasses RLS, which migrations/002 turns on for all tables.
# Server-side only: never put it in the frontend or any NEXT_PUBLIC_ variable.
SUPABASE_KEY=sb_secret_your_key

# Shared secret for admin-only endpoints (POST /api/refresh-finished), sent as
# `Authorization: Bearer <token>`. Leave unset to disable those endpoints.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Deployment config ---
# Comma-separated browser origins allowed to call the API (the deployed frontend URL).
# Defaults to http://localhost:3000 when unset.
ALLOWED_ORIGINS=http://localhost:3000

# How many proxies sit in front of the app and append to X-Forwarded-For, so
# rate limits count each visitor rather than the load balancer. 1 on
# Render/Railway; 0 (default) when nothing is in front, as in local dev.
PROXY_HOPS=0

# Port to bind. Most hosts (Render/Railway) inject PORT automatically.
PORT=5000

# Set to 1/true ONLY for local debugging. Must stay off in production.
FLASK_DEBUG=0
