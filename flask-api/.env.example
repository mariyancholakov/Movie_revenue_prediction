# MOVIEGROSS API — environment contract. Copy to `.env` and fill in real values.
# Never commit the real .env (it is gitignored).

# --- Required secrets ---
TMDB_API_KEY=your_tmdb_api_key
SUPABASE_URL=https://your-project.supabase.co
# Must be the SECRET key (sb_secret_…, Project Settings → API Keys), not the
# publishable one. It bypasses RLS, which migrations/002 turns on for all tables.
# Server-side only: never put it in the frontend or any NEXT_PUBLIC_ variable.
SUPABASE_KEY=sb_secret_your_key

# --- Deployment config ---
# Comma-separated browser origins allowed to call the API (the deployed frontend URL).
# Defaults to http://localhost:3000 when unset.
ALLOWED_ORIGINS=http://localhost:3000

# Header the host's edge sets to the visitor's IP, so rate limits count each
# visitor rather than a proxy. CF-Connecting-IP on Render (Cloudflare edge).
# Leave unset in local dev, where the socket address is the visitor.
CLIENT_IP_HEADER=

# Shared secret the frontend's server sends (X-Internal-Key) so its fetches
# are rate-limited apart from visitors. Set the same value as INTERNAL_API_KEY
# on the frontend host (a server-only variable, not NEXT_PUBLIC_).
# Unset: every request counts as a visitor.
INTERNAL_API_KEY=

# Port to bind. Most hosts (Render/Railway) inject PORT automatically.
PORT=5000

# Set to 1/true ONLY for local debugging. Must stay off in production.
FLASK_DEBUG=0

# Optional: serve a different model file, e.g. a retrain candidate, to try it
# on live films before promoting it. Unset: models/box_office_model_final.pkl.
# MODEL_PATH=models/candidate_YYYYMMDD_HHMMSS.pkl

# Web push for saved films. Generate a pair with:
#   see the key-generation note at the top of push_alerts.py
# The public key is served to browsers; the private one signs the pushes.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
